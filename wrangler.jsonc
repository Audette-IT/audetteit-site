{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audetteit-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Only public/ is uploaded — keeps repo files (CLAUDE.md, README, etc.) off the site.
    "directory": "./public",
    "binding": "ASSETS",
    // Unknown URLs get public/404.html with a real 404 status (GitHub #76).
    "not_found_handling": "404-page",
    // Only the HTML page routes go through worker/index.js (Markdown
    // negotiation); everything else is served directly as a static asset.
    // Keep in sync with MARKDOWN_PAGES in worker/index.js.
    "run_worker_first": ["/", "/services", "/how-it-works", "/about", "/contact", "/privacy"]
  },
  "previews": {}
}
