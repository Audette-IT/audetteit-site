{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audetteit-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Only public/ is uploaded — keeps repo files (CLAUDE.md, README, etc.) off the site.
    "directory": "./public",
    "binding": "ASSETS",
    // Only the homepage goes through worker/index.js (Markdown negotiation);
    // everything else is served directly as a static asset.
    "run_worker_first": ["/"]
  },
  "previews": {}
}
